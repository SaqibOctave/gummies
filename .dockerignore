# Dependencies (installed fresh inside the image)
node_modules/

# Build output (regenerated by the image's build step)
dist/

# Environment / secrets - never bake these into an image
.env
.env.local
.env.*.local
*.local

# Runtime data - should come from volumes/bind mounts, not the image
logs/*
!logs/.gitkeep
uploads/*
!uploads/.gitkeep

# Version control
.git/
.gitignore

# Editor / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Docker files themselves (irrelevant inside the build context)
docker-compose.yml
docker-compose.*.yml
Dockerfile
.dockerignore

# Misc
coverage/
*.md

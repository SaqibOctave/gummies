{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for a single-vendor gummy e-commerce platform",
  "main": "dist/src/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "migrate": "ts-node --transpile-only database/migrate.ts up",
    "migrate:down": "ts-node --transpile-only database/migrate.ts down",
    "migrate:status": "ts-node --transpile-only database/migrate.ts status",
    "seed": "ts-node --transpile-only database/seeds/run.ts",
    "migrate:prod": "node dist/database/migrate.js up",
    "seed:prod": "node dist/database/seeds/run.js",
    "typecheck": "tsc --noEmit",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "minio": "^8.0.7",
    "multer": "^2.2.0",
    "nodemon": "^3.1.14",
    "pg": "^8.23.0",
    "winston": "^3.19.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.20.1",
    "@types/pg": "^8.21.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  }
}
